APP_NAME=FriendlyEats FastAPI
ENVIRONMENT=local

# Con un proyecto demo-* el emulador funciona sin login ni proyecto real.
# Si ya hiciste `firebase use`, pon aquí el ID de tu proyecto.
FIREBASE_PROJECT_ID=demo-friendlyeats

# Apunta al emulador de Firestore (debe coincidir con firebase.json).
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Solo para hablar con Firestore real (sprints posteriores). No se usa con el emulador.
# Guarda el JSON en secrets/ (ignorado por Git). NUNCA lo subas al repositorio.
# FIREBASE_CREDENTIALS_PATH=./secrets/service-account.json
