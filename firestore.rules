rules_version = '2';

// Sprint 1: todo el acceso a Firestore pasa por el servidor FastAPI (SDK de
// administrador, que no está sujeto a estas reglas). Se bloquea el acceso
// directo desde clientes. Las reglas por usuario/propietario llegan en el Sprint 2.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
